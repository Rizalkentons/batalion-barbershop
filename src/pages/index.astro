---
import { Image, getImage } from 'astro:assets';
import { Hero } from '@/components/ui/animated-hero';
import { InteractiveHoverButton } from '@/components/ui/interactive-hover-button';
import { ServiceCards } from '@/components/ui/service-cards';
import { SiteCursor } from '@/components/ui/site-cursor';
import { SiteNavbar } from '@/components/ui/site-navbar';
import { TreatmentReceipt } from '@/components/ui/treatment-receipt';
import { TestimonialsSection } from '@/components/ui/testimonials-section';
import '../styles/global.css';

import hero from '../assets/images/hero.jpg';
import brandDetail from '../assets/images/brand-detail.jpg';
import barberAtWork01 from '../assets/images/barber-at-work-01.jpg';
import barberAtWork02 from '../assets/images/barber-at-work-02.jpg';
import haircut01 from '../assets/images/haircut-01.jpg';
import haircut02 from '../assets/images/haircut-02.jpg';
import haircut03 from '../assets/images/haircut-03.jpg';
import logo from '../assets/images/logo.jpeg';

const whatsappNumber = '6285274275005';
const whatsappMessage = encodeURIComponent(
  'Halo Batalion Barbershop, saya ingin booking potong rambut. Apakah ada slot yang tersedia hari ini?'
);
const whatsappUrl = `https://wa.me/${whatsappNumber}?text=${whatsappMessage}`;
const instagramUrl = 'https://www.instagram.com/batalion.barber/';
const mapsUrl = 'https://share.google/otw6AIishHbVFZoKE';
const address = 'Ruko Puri Beta Center, Jl. Puri Beta No.17 Lot.01, RT.003/RW.012, Larangan Utara, Kec. Larangan, Kota Tangerang, Banten 15154';
const mapEmbedUrl = `https://www.google.com/maps?q=${encodeURIComponent(address)}&output=embed`;
const heroBackground = await getImage({
  src: hero,
  width: 1920,
  format: 'webp',
  quality: 86,
});

const services = [
  {
    name: 'Basic Cut',
    price: '45K',
    tag: 'ESSENTIAL',
    features: ['Haircut', 'Hair tonic', 'Pomade'],
  },
  {
    name: 'Regular Cut',
    price: '55K',
    tag: 'BEST VALUE',
    featured: true,
    features: ['Haircut', 'Tonic', 'Pomade', 'Hair wash'],
  },
  {
    name: 'Premium Cut',
    price: '65K',
    tag: 'FULL EXPERIENCE',
    features: ['Haircut', 'Tonic', 'Pomade', 'Hair wash', 'Massage'],
  },
];

const treatments = [
  { name: 'Hair Spa', price: '50K' },
  { name: 'Black Mask', price: '35K' },
  { name: 'Perming', price: '200K' },
  { name: 'Down Perm', price: '100K' },
];

// `position` is the CSS object-position that keeps the subject in frame when a tile crops the photo.
const gallery = [
  { src: barberAtWork01, alt: 'Capster Batalion Barbershop sedang melayani pelanggan', className: 'gallery-tall', position: '25% 60%' },
  { src: haircut01, alt: 'Detail hasil haircut di Batalion Barbershop Larangan', className: '', position: 'center 35%' },
  { src: barberAtWork02, alt: 'Proses potong rambut di Batalion Barbershop', className: '', position: 'center 84%' },
  { src: haircut02, alt: 'Hasil potong rambut modern di Batalion Barbershop', className: 'gallery-tall', position: 'center 45%' },
  { src: haircut03, alt: 'Gaya rambut pelanggan Batalion Barbershop', className: '', position: 'center 50%' },
  { src: brandDetail, alt: 'Interior dan produk grooming Batalion Barbershop', className: '', position: 'center 90%' },
];

// The tiles are small, so the lightbox gets its own large rendition instead of enlarging a thumbnail.
const galleryItems = await Promise.all(
  gallery.map(async (item) => ({
    ...item,
    full: (await getImage({ src: item.src, width: 1400, format: 'webp', quality: 84 })).src,
  }))
);

const localBusinessSchema = {
  '@context': 'https://schema.org',
  '@type': 'BarberShop',
  name: 'Batalion Barbershop',
  description: 'Barbershop modern-classic di Puri Beta, Larangan, Tangerang dengan capster berpengalaman, gaya terkini, dan harga affordable.',
  telephone: '+62-852-7427-5005',
  priceRange: 'Rp35.000–Rp200.000',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Ruko Puri Beta Center, Jl. Puri Beta No.17 Lot.01, RT.003/RW.012',
    addressLocality: 'Larangan Utara',
    addressRegion: 'Banten',
    postalCode: '15154',
    addressCountry: 'ID',
  },
  openingHoursSpecification: {
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
    opens: '11:00',
    closes: '21:00',
  },
  sameAs: [instagramUrl, mapsUrl],
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Batalion Barbershop Services',
    itemListElement: [
      { '@type': 'Offer', name: 'Basic Cut', price: '45000', priceCurrency: 'IDR' },
      { '@type': 'Offer', name: 'Regular Cut', price: '55000', priceCurrency: 'IDR' },
      { '@type': 'Offer', name: 'Premium Cut', price: '65000', priceCurrency: 'IDR' },
      { '@type': 'Offer', name: 'Hair Spa', price: '50000', priceCurrency: 'IDR' },
      { '@type': 'Offer', name: 'Black Mask', price: '35000', priceCurrency: 'IDR' },
      { '@type': 'Offer', name: 'Perming', price: '200000', priceCurrency: 'IDR' },
      { '@type': 'Offer', name: 'Down Perm', price: '100000', priceCurrency: 'IDR' },
    ],
  },
};
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#090909" />
    <meta
      name="description"
      content="Batalion Barbershop di Puri Beta, Larangan, Tangerang. Haircut mulai Rp45.000. Lihat layanan, lokasi, dan booking langsung melalui WhatsApp."
    />
    <meta property="og:title" content="Batalion Barbershop — Larangan, Tangerang" />
    <meta
      property="og:description"
      content="Potongan presisi, gaya berkarakter. Booking haircut di Batalion Barbershop melalui WhatsApp."
    />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={hero.src} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&family=Oswald:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><rect width=%22100%22 height=%22100%22 fill=%22%23090909%22/><text x=%2250%22 y=%2268%22 font-size=%2255%22 text-anchor=%22middle%22 fill=%22%23f4c430%22 font-family=%22Arial%22>B</text></svg>" />
    <title>Batalion Barbershop — Barbershop di Larangan, Tangerang</title>
    <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />
  </head>
  <body>
    <a class="skip-link" href="#main">Lewati ke konten utama</a>

    <header class="site-header" data-header>
      <div class="container header-inner header-tubelight">
        <a class="brand-logo" href="#home" aria-label="Batalion Barbershop, kembali ke atas">
          <Image src={logo} alt="Logo Batalion Barbershop" width={68} height={68} format="webp" quality={90} />
        </a>

        <SiteNavbar client:load />

        <InteractiveHoverButton
          client:load
          text="Booking"
          href={whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          className="header-react-cta h-11 min-w-36"
        />
      </div>
    </header>

    <main id="main">
      <div id="home">
        <Hero
          client:load
          backgroundImage={heroBackground.src}
          whatsappUrl={whatsappUrl}
          servicesHref="#services"
        />
      </div>

      <section class="section about" id="about">
        <div class="container about-grid">
          <div class="section-copy reveal">
            <p class="kicker">01 / Tentang Kami</p>
            <h2>BUKAN SEKADAR <em>POTONG RAMBUT.</em></h2>
            <p class="lead">
              Batalion Barbershop adalah ruang grooming modern-classic dengan capster berpengalaman yang memahami model rambut terkini.
            </p>
            <p class="muted">
              Kami percaya potongan yang tepat bisa membangun karakter dan rasa percaya diri. Karena itu, setiap detail dikerjakan dengan rapi—tanpa membuat pengalaman berkualitas terasa mahal.
            </p>
            <a class="text-link text-link-yellow" href={instagramUrl} target="_blank" rel="noopener noreferrer">
              Ikuti @batalion.barber <span aria-hidden="true">↗</span>
            </a>
          </div>

          <div class="about-visual reveal">
            <div class="about-image-main">
              <Image
                src={barberAtWork02}
                alt="Capster Batalion Barbershop saat melayani pelanggan"
                widths={[480, 720, 960]}
                sizes="(min-width: 900px) 42vw, 90vw"
                format="webp"
                quality={84}
              />
            </div>
            <div class="about-image-float">
              <Image
                src={barberAtWork01}
                alt="Aktivitas capster Batalion Barbershop saat melayani pelanggan"
                width={360}
                format="webp"
                quality={82}
              />
            </div>
            <div class="quality-stamp">
              <Image src={logo} alt="Logo Batalion Barbershop" width={180} height={180} format="webp" quality={92} />
            </div>
          </div>
        </div>
      </section>

      <section class="section services" id="services">
        <div class="container">
          <div class="section-heading reveal">
            <div>
              <p class="kicker">02 / Services & Price</p>
              <h2>PILIH <em>EXPERIENCE</em>-MU.</h2>
            </div>
            <p>Harga transparan. Tidak ada kejutan—selain hasil yang bikin lebih percaya diri.</p>
          </div>

          <ServiceCards client:visible services={services} whatsappNumber={whatsappNumber} />

          <TreatmentReceipt client:visible treatments={treatments} whatsappNumber={whatsappNumber} />
        </div>
      </section>

      <section class="section gallery" id="gallery">
        <div class="container">
          <div class="section-heading gallery-heading reveal">
            <div>
              <p class="kicker">03 / Our Work</p>
              <h2>CRAFT YANG <em>TERLIHAT.</em></h2>
            </div>
            <a class="text-link" href={instagramUrl} target="_blank" rel="noopener noreferrer">
              Lihat lebih banyak di Instagram <span aria-hidden="true">↗</span>
            </a>
          </div>

          <div class="gallery-grid">
            {galleryItems.map((item, index) => (
              <button class:list={['gallery-item', item.className]} type="button" data-gallery-item data-full={item.full} aria-label={`Perbesar foto galeri ${index + 1}`}>
                <Image
                  src={item.src}
                  alt={item.alt}
                  widths={[320, 480, 640, 800]}
                  sizes="(min-width: 1024px) 300px, (min-width: 681px) 32vw, 46vw"
                  format="webp"
                  quality={82}
                  loading="lazy"
                  style={`object-position: ${item.position}`}
                />
                <span class="gallery-index">0{index + 1}</span>
                <span class="gallery-open" aria-hidden="true">＋</span>
              </button>
            ))}
          </div>
        </div>
      </section>

      <TestimonialsSection client:visible googleMapsUrl={mapsUrl} />

      <section class="section location" id="location">
        <div class="container">
          <div class="section-heading reveal">
            <div>
              <p class="kicker">04 / Find Us</p>
              <h2>DATANG. DUDUK.<br /><em>KELUAR LEBIH TAJAM.</em></h2>
            </div>
          </div>

          <div class="location-grid">
            <div class="location-info reveal">
              <span class="location-label">BATALION BARBERSHOP</span>
              <h3>Puri Beta Center</h3>
              <p>{address}</p>

              <div class="hours">
                <div><span>Buka</span><strong>Setiap hari</strong></div>
                <div><span>Jam</span><strong>11.00–21.00 WIB</strong></div>
              </div>

              <div class="location-actions">
                <InteractiveHoverButton
                  client:load
                  text="Buka Google Maps"
                  href={mapsUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                />
                <a class="text-link" href={whatsappUrl} target="_blank" rel="noopener noreferrer">
                  Hubungi kami <span aria-hidden="true">↗</span>
                </a>
              </div>
            </div>

            <div class="map-wrap reveal">
              <iframe
                src={mapEmbedUrl}
                title="Lokasi Batalion Barbershop di Puri Beta, Larangan"
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"
                allowfullscreen
              ></iframe>
              <div class="map-corner" aria-hidden="true">PURI BETA · TANGERANG</div>
            </div>
          </div>
        </div>
      </section>

      <section class="final-cta">
        <div class="final-cta-bg" aria-hidden="true">
          <Image src={barberAtWork01} alt="" widths={[640, 1000, 1600, 2200]} sizes="100vw" format="webp" quality={70} />
        </div>
        <div class="final-cta-overlay"></div>
        <div class="container final-cta-content reveal">
          <p class="kicker">Ready for a fresh cut?</p>
          <h2>WAKTUNYA TAMPIL<br /><em>LEBIH BERKARAKTER.</em></h2>
          <InteractiveHoverButton
            client:load
            text="Booking Sekarang"
            href={whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            className="mt-12 h-16 min-w-56"
          />
        </div>
      </section>
    </main>

    <footer class="footer">
      <div class="container footer-grid">
        <div>
          <a class="brand-logo brand-logo-footer" href="#home" aria-label="Batalion Barbershop, kembali ke atas">
            <Image src={logo} alt="Logo Batalion Barbershop" width={160} height={160} format="webp" quality={90} />
          </a>
          <p>Modern style. Classic craft.<br />Larangan, Tangerang.</p>
        </div>
        <div class="footer-nav">
          <p>EXPLORE</p>
          <a href="#about">Tentang</a>
          <a href="#services">Layanan</a>
          <a href="#gallery">Galeri</a>
          <a href="#location">Lokasi</a>
        </div>
        <div class="footer-nav">
          <p>CONNECT</p>
          <a href={instagramUrl} target="_blank" rel="noopener noreferrer">Instagram ↗</a>
          <a href={whatsappUrl} target="_blank" rel="noopener noreferrer">WhatsApp ↗</a>
          <a href={mapsUrl} target="_blank" rel="noopener noreferrer">Google Maps ↗</a>
        </div>
      </div>
      <div class="container footer-bottom">
        <span>© {new Date().getFullYear()} Batalion Barbershop</span>
        <span>Open daily · 11.00–21.00</span>
      </div>
    </footer>

    <a class="floating-whatsapp" href={whatsappUrl} target="_blank" rel="noopener noreferrer" aria-label="Booking melalui WhatsApp">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12.04 2A9.84 9.84 0 0 0 3.6 16.9L2 22l5.24-1.54A9.94 9.94 0 1 0 12.04 2Zm5.77 14.07c-.25.72-1.45 1.34-2 1.43-.52.1-1.18.14-1.9-.09-.44-.14-1-.33-1.72-.64-3.03-1.3-5-4.34-5.15-4.54-.15-.2-1.23-1.64-1.23-3.12 0-1.48.78-2.21 1.05-2.51.28-.3.6-.37.8-.37h.58c.18.01.43-.07.67.51l.86 2.1c.07.14.11.31.02.5-.08.2-.13.31-.26.48-.13.17-.28.38-.4.51-.14.14-.28.29-.12.58.16.3.7 1.15 1.5 1.86 1.03.92 1.9 1.2 2.2 1.35.28.15.45.13.62-.07.17-.2.72-.84.91-1.13.2-.28.39-.23.66-.13.27.1 1.7.8 1.99.95.29.14.48.22.55.34.07.13.07.73-.18 1.45Z"/></svg>
      <span>Booking</span>
    </a>

    <SiteCursor client:media="(hover: hover) and (pointer: fine)" />

    <dialog class="lightbox" data-lightbox>
      <button type="button" data-lightbox-close aria-label="Tutup galeri">×</button>
      <img src="" alt="Foto galeri Batalion Barbershop" data-lightbox-image />
    </dialog>

    <script>
      const header = document.querySelector('[data-header]');
      const syncHeader = () => header?.classList.toggle('is-scrolled', window.scrollY > 24);
      syncHeader();
      window.addEventListener('scroll', syncHeader, { passive: true });

      const revealObserver = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            revealObserver.unobserve(entry.target);
          }
        });
      }, { threshold: 0.12 });
      document.querySelectorAll('.reveal').forEach((el) => revealObserver.observe(el));

      const lightbox = document.querySelector('[data-lightbox]');
      const lightboxImage = document.querySelector('[data-lightbox-image]');
      document.querySelectorAll('[data-gallery-item]').forEach((item) => {
        item.addEventListener('click', () => {
          const image = item.querySelector('img');
          if (!(lightbox instanceof HTMLDialogElement) || !(lightboxImage instanceof HTMLImageElement) || !image) return;
          // Show the thumbnail at once, then swap in the large version when it has loaded.
          const full = item.getAttribute('data-full');
          lightboxImage.src = image.currentSrc || image.src;
          lightboxImage.alt = image.alt;
          lightbox.showModal();
          if (full) {
            lightboxImage.dataset.full = full;
            const preload = new Image();
            preload.onload = () => {
              if (lightbox.open && lightboxImage.dataset.full === full) lightboxImage.src = full;
            };
            preload.src = full;
          }
        });
      });
      document.querySelector('[data-lightbox-close]')?.addEventListener('click', () => {
        if (lightbox instanceof HTMLDialogElement) lightbox.close();
      });
      lightbox?.addEventListener('click', (event) => {
        if (event.target === lightbox && lightbox instanceof HTMLDialogElement) lightbox.close();
      });
    </script>
  </body>
</html>
